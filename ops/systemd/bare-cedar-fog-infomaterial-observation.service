ExecStart=/home/emsenn/.config/nvm/versions/node/v24.13.1/bin/node bin/server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/emsenn/info/lib/emsenn/services/board-of-directors/services/executive-office/services/leader-movement-team/content/documents/articles
ReadWritePaths=/home/emsenn/info/lib/emsenn/services/561-group/services/lenticule-science/services/obsmetrological-services-section/services/infomaterial-observation/data

[Install]
