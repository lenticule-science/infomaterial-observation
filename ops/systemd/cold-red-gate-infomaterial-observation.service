[Unit]
Description=Cold-red-gate finite infomaterial observation A2A provider
After=network-online.target rwil-rdf-services.service
Wants=network-online.target
Requires=rwil-rdf-services.service

[Service]
Type=simple
WorkingDirectory=%h/services/infomaterial-observation
Environment=PORT=18794
Environment=HOST=127.0.0.1
Environment=BASE_URL=http://127.0.0.1:18794
Environment=RWIL_RDF_AGENT=http://127.0.0.1:8787/.well-known/agent-card.json
Environment=INFOMATERIAL_TERRITORY_ROOT=%h/services/rmn-semantic-conformance/content/contracts
Environment=AGENT_CARD_SIGNING_KEY=%h/services/infomaterial-observation/data/agent-card-signing/ed25519-private.pem
Environment=AGENT_CARD_JWKS=%h/services/infomaterial-observation/content/agent-card-signing/jwks.json
Environment=AGENT_CARD_SIGNING_KID=infomaterial-observation-cold-red-gate-ed25519
ExecStart=/usr/bin/node %h/services/infomaterial-observation/bin/server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/services/infomaterial-observation/data

[Install]
WantedBy=default.target
